# ==========================================
# The Lenny Growth Assistant - Environment Config
# Copy this file to .env and adjust as needed. Never commit .env.
# ==========================================

# Application Settings
APP_NAME="The Lenny Growth Assistant"
APP_VERSION="1.0.0"
DEBUG=false

# Persistence (PostgreSQL with resilient SQLite fallback)
# Defaults to local PostgreSQL if available; if unreachable, falls back to SQLite automatically
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_assistant"
# Override the fallback file location (optional):
# SQLITE_FALLBACK_URL="sqlite+aiosqlite:///data/lenny_fallback.db"

# Local LLM Runtime (Ollama - Mandatory for Demo)
OLLAMA_BASE_URL="http://localhost:11434"
DEFAULT_LOCAL_MODEL="llama3.2:1b"

# Cloud LLM Runtime (Groq - Optional/Recommended for High-Speed Essays)
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"
DEFAULT_GROQ_MODEL="llama-3.3-70b-versatile"

# Optional Cloud Providers
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Active Provider on Startup ("ollama" | "groq" | "anthropic" | "openai")
ACTIVE_PROVIDER="ollama"
ACTIVE_MODEL="llama3.2:1b"

# CORS allow-list (JSON array). Keep it explicit; credentials are enabled.
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
